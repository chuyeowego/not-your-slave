# Copy to .env.local. Never commit secrets.

# Required locally: AI Gateway key, or `eve link` (OIDC). A Vercel deploy needs neither.
AI_GATEWAY_API_KEY=

# Required away from localhost: HTTP Basic for /eve/v1.
AGENT_USER=
AGENT_PASS=

# Optional. Postgres for mindlog and push; JSONL otherwise. POSTGRES_URL is the fallback.
DATABASE_URL=
POSTGRES_URL=

# Web Push (VAPID). Generate once; never commit the private key:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
